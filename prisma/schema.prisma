generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
}

enum PIStatus {
  DRAFT
  SENT
  PAID
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum POStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

model Company {
  id            String   @id @default(cuid())
  name          String
  legalName     String?
  email         String?
  phone         String?
  website       String?
  address       String?
  taxId         String?
  logoUrl       String?
  currency      String   @default("USD")
  
  // Bank Account Details
  bankName      String?
  accountName   String?
  accountNumber String?
  routingNumber String?
  branchName    String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users            User[]
  clients          Client[]
  vendors          Vendor[]
  items            Item[]
  estimates        Estimate[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
  purchaseOrders   PurchaseOrder[]
}

model User {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  email            String   @unique
  passwordHash     String
  role             Role     @default(ADMIN)
  
  // 2FA Google Authenticator (TOTP)
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Client {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  contactPerson   String?
  email           String?
  phone           String?
  taxId           String?
  currency        String   @default("USD")
  billingAddress  String?
  shippingAddress String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  estimates        Estimate[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
}

model Vendor {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  taxId         String?
  currency      String   @default("USD")
  address       String?
  paymentTerms  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
}

model Item {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  type        ItemType @default(PRODUCT)
  unitPrice   Float
  taxRate     Float    @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Estimate {
  id             String         @id @default(cuid())
  companyId      String
  clientId       String
  estimateNumber String
  status         EstimateStatus @default(DRAFT)
  issueDate      DateTime       @default(now())
  expiryDate     DateTime?
  subtotal       Float          @default(0)
  taxAmount      Float          @default(0)
  totalAmount    Float          @default(0)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items            EstimateItem[]
  proformaInvoices ProformaInvoice[]
  invoices         Invoice[]
}

model EstimateItem {
  id          String @id @default(cuid())
  estimateId  String
  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  taxRate     Float  @default(0)
  amount      Float  @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
}

model ProformaInvoice {
  id          String   @id @default(cuid())
  companyId   String
  clientId    String
  estimateId  String?
  piNumber    String
  status      PIStatus @default(DRAFT)
  issueDate   DateTime @default(now())
  dueDate     DateTime?
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  totalAmount Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  estimate Estimate?             @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  items    ProformaInvoiceItem[]
  invoices Invoice[]
}

model ProformaInvoiceItem {
  id                String @id @default(cuid())
  proformaInvoiceId String
  description       String
  quantity          Float  @default(1)
  unitPrice         Float  @default(0)
  taxRate           Float  @default(0)
  amount            Float  @default(0)

  proformaInvoice ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  clientId      String
  estimateId    String?
  proformaId    String?
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float         @default(0)
  taxAmount     Float         @default(0)
  totalAmount   Float         @default(0)
  paymentMethod String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  estimate        Estimate?        @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  proformaInvoice ProformaInvoice? @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  items           InvoiceItem[]
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  taxRate     Float  @default(0)
  amount      Float  @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  companyId    String
  vendorId     String
  poNumber     String
  status       POStatus @default(DRAFT)
  issueDate    DateTime @default(now())
  expectedDate DateTime?
  subtotal     Float    @default(0)
  taxAmount    Float    @default(0)
  totalAmount  Float    @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor  Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items   PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Float  @default(1)
  unitPrice       Float  @default(0)
  taxRate         Float  @default(0)
  amount          Float  @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}
